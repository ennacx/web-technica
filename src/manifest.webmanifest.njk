---
permalink: /manifest.webmanifest
eleventyExcludeFromCollections: true
---

{
    "id": "{{ '/' | url }}",
    "name": "{{ site.name }}",
    "short_name": "{{ site.name }}",
    "description": "{{ site.description }}",
    "lang": "{{ site.language }}",
    "start_url": "{{ '/' | url }}",
    "scope": "{{ '/' | url }}",
    "display": "standalone",
    "background_color": "#151a20",
    "theme_color": "#151a20",
    "icons": [
        { "src": "{{ '/assets/img/brand/icon-192.png' | url }}", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
        { "src": "{{ '/assets/img/brand/icon-512.png' | url }}", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
    ]
}
