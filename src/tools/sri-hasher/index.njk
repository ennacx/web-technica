---
layout: layouts/base.njk
title: SRI Hasher
description: Generate SHA-256, SHA-384, or SHA-512 Subresource Integrity hashes and HTML tags from a CDN URL or local JavaScript and CSS files.
permalink: /sri-hasher/index.html
pageClass: sri-hasher
pageStylesheet: /sri-hasher/css/sri-hasher.css
pageScript: /sri-hasher/js/index.js
---

{% from "components/icons.njk" import icon %}

<nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="{{ '/' | url }}#tools">{{ icon('arrow-left') }} Tools</a>
    {{ icon('chevron-right') }} <span aria-current="page">{{ title }}</span>
</nav>

<header class="tool-heading">
    <div class="tool-heading-copy">
        <span class="tool-heading-icon">{{ icon('code') }}</span>
        <div><h1>{{ title }}</h1><p>Generate integrity hashes and ready-to-use HTML tags.</p></div>
    </div>

    <div class="local-processing">{{ icon('shield-check') }}<div><strong>Hashing in your browser</strong><span>URL mode contacts the resource host.</span></div></div>
</header>

<div data-sri-hasher class="sri-layout">
    <form id="sri-form" class="panel" novalidate>
        <fieldset id="sri-settings" class="field">
            <legend class="field-title">Resource</legend>

            <fieldset class="field sri-source-options">
                <legend class="visually-hidden">Resource source</legend>
                <label class="checkbox"><input type="radio" name="source-mode" value="fetch" checked><span>CDN URL</span></label>
                <label class="checkbox"><input type="radio" name="source-mode" value="file"><span>Local File</span></label>
            </fieldset>

            <div id="sri-url-fields">
                <label class="field-label" for="sri-url">Resource URL</label>
                <input id="sri-url" class="input" type="url" placeholder="https://cdn.example.com/library.min.js" autocomplete="off" spellcheck="false" aria-describedby="sri-url-help sri-error">

                <p id="sri-url-help" class="field-help">The URL is fetched only when you select Generate SRI. The host must allow CORS. HTTP URLs may be blocked on HTTPS pages.</p>
            </div>

            <div id="sri-file-fields" hidden>
                <label class="field-label" for="sri-file">Resource file</label>
                <input id="sri-file" class="input" type="file" accept=".js,.css" disabled aria-describedby="sri-file-help sri-error">

                <p id="sri-file-help" class="field-help">The file is read on this device and is never uploaded.</p>
            </div>

            <label class="field-label" for="sri-algorithm">Hash algorithm</label>
            <select id="sri-algorithm" class="input">
                <option>SHA-256</option>
                <option>SHA-384</option>
                <option>SHA-512</option>
            </select>

            <p class="field-help sri-form-note">Supported resources: JavaScript (.js) and CSS (.css).</p>
        </fieldset>

        <p id="sri-error" class="notice notice-error" role="alert" tabindex="-1" hidden></p>

        <button id="sri-generate" class="button button-primary" type="submit">{{ icon('refresh') }} <span>Generate SRI</span></button>

        <p id="sri-progress" class="field-help" role="status" aria-live="polite"></p>
    </form>

    <section id="sri-result-panel" class="panel" aria-labelledby="sri-result-heading" aria-busy="false">
        <h2 id="sri-result-heading">Result</h2>
        <p id="sri-empty" class="field-help">Choose a resource and generate its integrity hash.</p>

        <div id="sri-results" hidden>
            <div class="sri-result-heading"><h3 id="sri-value-heading">Integrity value</h3><button id="sri-copy" class="button" type="button" disabled>{{ icon('copy') }} Copy SRI</button></div>
            <pre id="sri-value" class="result-output" tabindex="0" aria-labelledby="sri-value-heading"></pre>

            <div class="sri-result-heading"><h3 id="sri-tag-heading">HTML tag</h3><button id="sri-tag-copy" class="button" type="button" disabled>{{ icon('copy') }} Copy Tag</button></div>
            <pre id="sri-tag" class="result-output" tabindex="0" aria-labelledby="sri-tag-heading"></pre>

            <p id="sri-result-note" class="field-help"></p>
        </div>
        <p id="sri-copy-status" class="field-help" role="status" aria-live="polite" aria-atomic="true"></p>
    </section>
</div>

<aside class="sri-help" aria-labelledby="sri-help-heading">
    <h2 id="sri-help-heading">Using the result</h2>
    <p>Use a versioned resource URL and verify that the content comes from a trusted source. SRI checks that the served bytes match the hash; it does not establish whether the code is safe. If the resource changes, regenerate the hash.</p>
    <p>Cross-origin resources need CORS support. For local files, update the generated relative path to match the file's published location.</p>
</aside>

<noscript><p class="notice notice-warning">Enable JavaScript to generate SRI hashes. Local files are processed in your browser.</p></noscript>
