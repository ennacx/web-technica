---
toolSlug: json-editor
description: View, edit, format, and validate JSON directly in your browser.
permalink: /json-editor/index.html
pageClass: json-editor
pageStylesheet: /json-editor/css/json-editor.css
pageScript: /json-editor/js/index.js
toolIntro:
    - Inspect, format, and edit JSON in one place.
processingNotice:
    icon: lock
    title: Your JSON stays here
    description: No uploads or browser storage.
javascriptNotice: Enable JavaScript to use the JSON editor preview.
---

{% from "components/icons.njk" import icon %}

<p id="json-preview-note" class="json-preview-note"><span class="badge">In development</span> Edit, format, minify, and naturally sort JSON keys. Your data stays in your browser.</p>

<section class="json-workspace" aria-label="JSON editor" aria-describedby="json-preview-note">
    <div class="json-document-bar">
        <div class="json-filename-group">
            <div id="json-filename-display" class="json-filename-display">
                <h2>{{ icon('document') }} <span id="json-filename">document.json</span></h2>
                <button type="button" id="json-rename" class="button button-icon" aria-label="Edit file name" title="Edit file name" aria-controls="json-filename-form" aria-expanded="false">{{ icon('pencil') }}</button>
            </div>

            <form id="json-filename-form" class="json-filename-form" hidden novalidate>
                <label for="json-filename-input" class="visually-hidden">File name</label>
                <input id="json-filename-input" class="input" type="text" value="document.json" required autocomplete="off" spellcheck="false" aria-describedby="json-filename-error">

                <button type="submit" class="button button-primary button-icon" aria-label="Confirm file name" title="Confirm file name">{{ icon('check') }}</button>

                <p id="json-filename-error" class="json-filename-error field-help" role="alert" hidden></p>
            </form>
        </div>

        <div class="json-document-actions">
            <div class="json-modes" role="group" aria-label="Editor mode">
                <button type="button" id="json-edit" class="button" aria-pressed="true" aria-controls="json-input">Edit</button>
                <button type="button" id="json-view" class="button" aria-pressed="false" aria-controls="json-display">View</button>
            </div>

            <button type="button" id="json-copy" class="button button-icon" aria-label="Copy source" title="Copy source" disabled>{{ icon('copy') }}</button>
            <button type="button" id="json-download" class="button button-icon" aria-label="Save source" title="Save source" disabled>{{ icon('download') }}</button>
        </div>
    </div>

    <div class="json-toolbar">
        <div class="json-actions" role="group" aria-label="JSON operations" aria-describedby="json-mode-help json-format-help">
            <button type="button" id="json-pretty" class="button" aria-describedby="json-format-help" disabled>Pretty Print</button>
            <button type="button" id="json-minify" class="button" aria-describedby="json-format-help" disabled>Minify</button>
            <button type="button" id="json-sort" class="button" aria-describedby="json-format-help json-sort-help" disabled>
                <span id="json-sort-asc-icon">{{ icon('sort-ascending') }}</span>
                <span id="json-sort-desc-icon" hidden>{{ icon('sort-descending') }}</span>
                <span id="json-sort-label">Sort Ascending</span>
            </button>
        </div>
        <div class="json-indent">
            <label for="json-indent">Indent</label>
            <select id="json-indent" class="input" aria-describedby="json-indent-help json-mode-help json-format-help">
                <option value="2">2 spaces</option>
                <option value="4">4 spaces</option>
                <option value="8">8 spaces</option>
            </select>
        </div>
    </div>

    <div class="json-editor-body">
        <label for="json-input" class="visually-hidden">JSON source</label>
        <textarea id="json-input" class="json-input" spellcheck="false" autocomplete="off" autocapitalize="off" wrap="off" aria-describedby="json-syntax json-error json-input-help" placeholder='Paste your JSON here, or load the sample below…'></textarea>

        <div id="json-display" class="json-display" hidden>
            <div id="json-lines" class="json-line-numbers" aria-hidden="true"></div>
            <pre id="json-code" tabindex="0" aria-label="JSON display, read only" aria-describedby="json-syntax json-error"></pre>
        </div>

        <p id="json-action-status" class="json-action-status" role="status" aria-live="polite" aria-atomic="true" aria-label="Last action"></p>
    </div>

    <div class="json-status-bar">
        <div class="json-validation" role="status" aria-live="polite" aria-atomic="true">
            <p id="json-syntax" data-state="empty"><span class="json-status-dot" aria-hidden="true"></span><span id="json-syntax-text">No JSON yet</span></p>
            <p id="json-error" class="json-error" hidden></p>
        </div>
        <div class="json-status-actions">
            <button type="button" id="json-validate" class="button" aria-label="Validate source JSON" title="Validate source JSON" disabled>{{ icon('shield-check') }} Validate</button>
            <span id="json-stats">0 characters · 1 line</span>
        </div>

        <p id="json-format-help" class="field-help json-format-help" role="status" aria-live="polite" hidden></p>
    </div>
</section>

<div class="json-below-editor">
    <div class="json-editor-help">
        <p id="json-mode-help" class="field-help">Edit: operations, validation, Copy, and Save use the source.</p>
        <p id="json-indent-help" class="field-help">Indent keeps existing line breaks. Pretty Print rebuilds the layout. View operations require valid JSON; display settings are kept while you fix errors.</p>
        <p id="json-input-help" class="field-help">In Edit, Enter continues indentation; closing braces and brackets align with their opening line.</p>
        <p id="json-sort-help" class="field-help">Sort applies to all object keys using natural order. Array order and duplicate keys are kept. The button shows the next sort direction.</p>
    </div>

    <button type="button" id="json-sample" class="button">{{ icon('code') }} Load sample</button>
</div>

