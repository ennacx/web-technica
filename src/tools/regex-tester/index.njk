---
toolSlug: regex-tester
description: Test regular expressions and inspect matches and capture groups.
permalink: /regex-tester/index.html
pageClass: regex-tester
pageStylesheet: /regex-tester/css/regex-tester.css
pageScript: /regex-tester/js/index.js
toolIntro:
    - Explore patterns, test text, and match results in one workspace.
processingNotice:
    icon: lock
    title: Your text stays here
    description: No uploads or browser storage.
javascriptNotice: Enable JavaScript to use Regex Tester.
---

{% from "components/icons.njk" import icon %}

<div id="regex-workspace" class="regex-workspace">
    <section id="regex-input-pane" class="regex-input-pane" aria-labelledby="regex-pattern-label">
        <div class="regex-pattern-settings">
            <div class="regex-section-heading"><h2 id="regex-pattern-label"><label for="regex-pattern">Regular expression</label></h2><span class="badge">JavaScript</span></div>
            <div class="regex-pattern-field"><span aria-hidden="true">/</span><input id="regex-pattern" type="text" value="(?&lt;name&gt;[\w.+-]+)@(?&lt;domain&gt;[\w.-]+\.[a-z]{2,})" spellcheck="false" autocomplete="off" autocapitalize="off" aria-describedby="regex-status"><span aria-hidden="true">/</span><span id="regex-flags-summary">gi</span></div>
            <div class="regex-options">
                <div class="regex-flags" role="group" aria-label="Regular expression flags">
                    <label title="Global search"><input type="checkbox" value="g" checked>g <span>global</span></label>
                    <label title="Ignore case"><input type="checkbox" value="i" checked>i <span>ignore case</span></label>
                    <label title="Multiline anchors"><input type="checkbox" value="m">m <span>multiline</span></label>
                    <label title="Dot matches newlines"><input type="checkbox" value="s">s <span>dot all</span></label>
                    <label title="Unicode mode"><input type="checkbox" value="u">u <span>unicode</span></label>
                </div>
                <div class="regex-run-controls"><label for="regex-mode">Run mode</label><select id="regex-mode" class="input"><option value="auto">Auto</option><option value="manual">Manual</option></select><button type="button" id="regex-run" class="button button-primary">Run</button></div>
            </div>
        </div>
        <div class="regex-text-heading regex-section-heading"><h2><label for="regex-text">Test text</label></h2><span id="regex-text-stats" class="field-help"></span></div>
        <textarea id="regex-text" spellcheck="false" autocomplete="off" autocapitalize="off" wrap="off" aria-describedby="regex-status">Contact the team:
  alice@example.com — Product
  bob@web-technica.dev — Engineering
  support@example.org — Support</textarea>
    </section>

    <div id="regex-splitter" class="regex-splitter" role="separator" tabindex="0" aria-label="Resize input panel" aria-orientation="horizontal" aria-controls="regex-input-pane" aria-valuemin="400" aria-valuemax="1600" aria-valuenow="480" aria-describedby="regex-resize-help"><span aria-hidden="true"></span></div>

    <section id="regex-results-pane" class="regex-results-pane" aria-labelledby="regex-results-title">
        <div class="regex-results-toolbar regex-section-heading">
            <h2 id="regex-results-title">Match results <span id="regex-match-count" class="badge">Not run</span></h2>
            <div class="regex-tabs" role="group" aria-label="Results view">
                <button type="button" id="regex-matches-tab" class="button" aria-pressed="true" aria-controls="regex-matches">Matches</button>
                <button type="button" id="regex-preview-tab" class="button" aria-pressed="false" aria-controls="regex-preview">Highlight</button>
            </div>
        </div>

        <div id="regex-results-scroll" class="regex-results-scroll" tabindex="0" role="region" aria-label="Match results">
            <div id="regex-matches"></div>
            <div id="regex-preview" hidden></div>

            <p id="regex-results-empty" class="regex-empty">No results yet.</p>
        </div>
    </section>
</div>

<div class="regex-status-bar">
    <p id="regex-status" role="status" aria-live="polite" aria-atomic="true">Not run.</p>
    <div class="regex-bottom-actions">
        <button type="button" id="regex-sample" class="button">{{ icon('code') }} Restore sample</button>
        <button type="button" id="regex-reset-layout" class="button">{{ icon('refresh') }} Reset layout</button>
    </div>
</div>

<p id="regex-resize-help" class="field-help regex-resize-help">Drag to resize the input panel. Results keep their height; the page grows as needed. Double-click to reset. With the handle focused, use ↑ / ↓ to resize, Home / End for limits, or Enter to reset.</p>
