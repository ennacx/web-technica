<footer class="site-footer">
    <div class="container footer-content">
        <a class="brand brand-small" href="{{ '/' | url }}">
            <img class="brand-symbol" src="{{ '/assets/img/brand/logo.svg' | url }}" alt="" width="24" height="24">
            <span>{{ site.name }}</span>
        </a>

        <small class="footer-version" aria-label="Version {{ siteVersion }}">
            <a href="{{ site.repositoryUrl }}/releases/tag/v{{ siteVersion }}" target="_blank" rel="noopener noreferrer">v{{ siteVersion }}</a>
        </small>

        <small class="footer-copyright">&copy; 2026 Enna.cx</small>

        <nav class="footer-nav" aria-label="Footer navigation">
            <a href="{{ '/assets/fonts/THIRD-PARTY-LICENSES.txt' | url }}">Font licenses</a>
            <a href="{{ site.repositoryUrl }}" target="_blank" rel="noopener noreferrer">GitHub<span class="visually-hidden"> (opens in a new tab)</span></a>
            <a href="{{ site.repositoryUrl }}/blob/master/LICENSE" target="_blank" rel="noopener noreferrer">MIT License<span class="visually-hidden"> (opens in a new tab)</span></a>
        </nav>
    </div>
</footer>
