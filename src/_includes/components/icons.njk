{# Local outline icons: no font, CDN, or client-side library required. #}

{% macro icon(name, className = '') %}
    <svg class="icon {{ className }}" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        {% if name == 'key' %}
            <circle cx="16" cy="8" r="5"/><circle cx="17" cy="7" r="0.7" fill="currentColor" stroke="none"/><path d="m12.3 11.7-9.3 9.3H1v-3l2-2h3v-3h3l3.3-3.3"/>
        {% elif name == 'shield' %}
            <path d="M12 2 3 6v6c0 5 9 10 9 10s9-5 9-10V6Z"/>
        {% elif name == 'shield-check' %}
            <path d="M12 2 4 5v6c0 5 8 10 8 10s8-5 8-10V5Z"/><path d="m8 11 3 3 5-5"/>
        {% elif name == 'code' %}
            <path d="m7 6-6 6 6 6m10-12 6 6-6 6m-3-15-4 18"/>
        {% elif name == 'json' %}
            <path d="M8 3H6a2 2 0 0 0-2 2v4a3 3 0 0 1-2 3 3 3 0 0 1 2 3v4a2 2 0 0 0 2 2h2m8-18h2a2 2 0 0 1 2 2v4a3 3 0 0 0 2 3 3 3 0 0 0-2 3v4a2 2 0 0 1-2 2h-2"/>
        {% elif name == 'window' %}
            <rect x="2" y="3" width="20" height="17" rx="3"/><path d="M2 8h20m-16-2h.01M9 6h.01"/><path d="m9 12-2 2 2 2m6-4 2 2-2 2"/>
        {% elif name == 'layers' %}
            <path d="m12 2 10 5-10 5L2 7Zm-10 10 10 5 10-5M2 17l10 5 10-5"/>
        {% elif name == 'arrow' %}
            <path d="M4 12h16m-6-6 6 6-6 6"/>
        {% elif name == 'github' %}
            <path d="M9 21v-4c-4 1-5-2-5-2m16-4c0 3-2 5-5 5 1 1 1 2 1 3v2M9 16c-3 0-5-2-5-5 0-2 1-3 2-4 0-1 0-3 1-4l4 2h3l4-2c1 1 1 3 1 4 1 1 2 2 2 4"/>
        {% elif name == 'lock' %}
            <rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 5v2"/>
        {% elif name == 'copy' %}
            <rect x="8" y="8" width="12" height="13" rx="2"/><path d="M15 5V3H3v13h2"/>
        {% elif name == 'check' %}
            <path d="m5 12 4 4L19 6"/>
        {% elif name == 'refresh' %}
            <path d="M20 8a9 9 0 0 0-15-3L2 8m0-5v5h5m-3 8a9 9 0 0 0 15 3l3-3m0 5v-5h-5"/>
        {% elif name == 'download' %}
            <path d="M12 3v12m-5-5 5 5 5-5M4 17v4h16v-4"/>
        {% elif name == 'document' %}
            <path d="M5 2h9l5 5v15H5Zm9 0v6h5M9 12h6m-6 5h6"/>
        {% elif name == 'arrow-left' %}
            <path d="M20 12H4m6-6-6 6 6 6"/>
        {% elif name == 'chevron-right' %}
            <path d="m9 5 7 7-7 7"/>
        {% elif name == 'wifi' %}
            <path d="M2 8a16 16 0 0 1 20 0M5 12a11 11 0 0 1 14 0m-11 4a6 6 0 0 1 8 0"/><circle cx="12" cy="20" r="1" fill="currentColor" stroke="none"/>
        {% elif name == 'plus' %}
            <path d="M12 5v14M5 12h14"/>
        {% endif %}
    </svg>
{% endmacro %}
