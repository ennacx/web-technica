{% from "components/icons.njk" import icon %}
{% from "components/offline-status.njk" import offlineStatus %}
{% from "components/tool-status.njk" import toolStatus %}

{% macro toolCard(tool, offlineModes) %}
    {% set available = tool | isToolAvailable %}

    <article class="tool-card{% if available %} is-available{% endif %}" aria-labelledby="tool-{{ tool.slug }}">
        <div class="tool-card-main">
            <div class="icon-tile">{{ icon(tool.icon) }}</div>
            <div class="tool-card-copy">
                <div class="tool-card-meta">
                    <span class="eyebrow">{{ tool.category }}</span>
                    <span class="tool-card-badges">
                        {{ offlineStatus(tool, offlineModes) }}
                        {{ toolStatus(tool) }}
                        {% if tool.status == 'published' and not available %}
                            <span class="badge">Coming soon</span>
                        {% endif %}
                    </span>
                </div>

                <h3 id="tool-{{ tool.slug }}">{% if available %}<a class="tool-card-link" href="{{ tool.url | url }}">{{ tool.name }}</a>{% else %}{{ tool.name }}{% endif %}</h3>

                <p>{{ tool.description }}</p>
            </div>
        </div>

        <ul class="tag-list" aria-label="{{ tool.name }} features">
            {% for tag in tool.tags %}
                <li class="tag">{{ tag }}</li>
            {% endfor %}
        </ul>
    </article>
{% endmacro %}
