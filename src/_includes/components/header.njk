{% from "components/icons.njk" import icon %}
{% from "components/tool-status.njk" import toolStatus %}

{% set categories = tools | groupAvailableTools %}
{% set toolsActive = (page.url == '/') %}

<header class="site-header">
    <div class="container header-content">
        <a class="brand" href="{{ '/' | url }}">
            <img class="brand-symbol" src="{{ '/assets/img/brand/logo.svg' | url }}" alt="" width="36" height="36">
            <span>{{ site.name }}</span>
        </a>

        <nav class="site-nav" aria-label="Main navigation" data-tool-navigation>
            <ul class="site-nav-list" role="list">
                <li><a href="{{ '/' | url }}#tools" class="site-nav-link{% if toolsActive %} is-current{% endif %}"{% if toolsActive %} aria-current="page"{% endif %}>All Tools</a></li>
                <li class="site-nav-mobile">
                    <details data-mobile-tool-navigation>
                        <summary class="site-nav-link site-nav-toggle{% if tool %} is-current{% endif %}">Tools {{ icon('chevron-right') }}</summary>
                        <div class="site-nav-dropdown site-nav-mobile-menu">
                            {% for category in categories %}
                                <details class="site-nav-mobile-category">
                                    <summary class="site-nav-link site-nav-toggle{% if tool and tool.category == category.name %} is-current{% endif %}">{{ category.name }} {{ icon('chevron-right') }}</summary>
                                    <ul role="list">
                                        {% for tool in category.tools %}
                                            <li><a href="{{ tool.url | url }}"{% if tool.url == page.url %} aria-current="page"{% endif %}>{{ icon(tool.icon) }}<span class="site-nav-tool-name">{{ tool.name }}</span>{{ toolStatus(tool) }}</a></li>
                                        {% endfor %}
                                    </ul>
                                </details>
                            {% endfor %}
                        </div>
                    </details>
                </li>
                {% for category in categories %}
                    <li class="site-nav-category">
                        <button class="site-nav-link site-nav-toggle{% if tool and tool.category == category.name %} is-current{% endif %}" type="button" aria-expanded="false" aria-controls="tool-category-{{ loop.index }}">
                            {{ category.name }} {{ icon('chevron-right') }}
                        </button>
                        <ul id="tool-category-{{ loop.index }}" class="site-nav-dropdown" role="list" hidden>
                            {% for tool in category.tools %}
                                <li><a href="{{ tool.url | url }}"{% if tool.url == page.url %} aria-current="page"{% endif %}>{{ icon(tool.icon) }}<span class="site-nav-tool-name">{{ tool.name }}</span>{{ toolStatus(tool) }}</a></li>
                            {% endfor %}
                        </ul>
                    </li>
                {% endfor %}
            </ul>
        </nav>

        <a class="github-link" href="{{ site.repositoryUrl }}" target="_blank" rel="noopener noreferrer">
            {{ icon('github') }}<span>GitHub</span><span class="visually-hidden"> (opens in a new tab)</span>
        </a>
    </div>
</header>
