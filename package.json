{
    "name": "web-technica",
    "version": "0.5.1",
    "private": true,
    "description": "Lightweight, privacy-friendly web utilities for developers.",
    "license": "MIT",
    "type": "module",
    "workspaces": [
        "src/tools/*"
    ],
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "eleventy --serve --port=18080 --pathprefix=/web-technica/",
        "build:keygen": "npm run build --workspace @web-technica/keygen",
        "build": "eleventy",
        "build:pages": "eleventy --pathprefix=/web-technica/",
        "test": "node --test",
        "verify:release": "node scripts/verify-release.mjs"
    },
    "devDependencies": {
        "@11ty/eleventy": "^3.1.7",
        "@resvg/resvg-js": "^2.6.2",
        "sass": "^1.106.0",
        "wawoff2": "^2.0.1"
    },
    "allowScripts": {
        "@parcel/watcher@2.6.0": true,
        "esbuild@0.25.12": true
    }
}
